{
  "description": "A 400 to a request with optional fields: one lean retry, remembered for later requests.",
  "config": {"base_url": "{server}/v1"},
  "server": [
    {
      "status": 400,
      "headers": {"content-type": "application/json"},
      "body": "{\"error\":{\"code\":\"unsupported_parameter\",\"message\":\"secret-server-detail\"}}"
    },
    {
      "status": 200,
      "headers": {"content-type": "text/event-stream"},
      "body_file": "../decoder/final.sse"
    },
    {
      "status": 200,
      "headers": {"content-type": "text/event-stream"},
      "body_file": "../decoder/final.sse"
    }
  ],
  "calls": [
    {
      "request": {
        "model": "m",
        "reasoning_effort": "low",
        "include_usage": true,
        "messages": [{"role": "user", "parts": [{"text": "hi"}]}]
      },
      "expect": {
        "completion": {"finish": "stop", "text": "42", "usage": {"input": 24, "output": 3, "total": 27}}
      }
    },
    {
      "request": {
        "model": "m",
        "reasoning_effort": "low",
        "include_usage": true,
        "messages": [{"role": "user", "parts": [{"text": "hi"}]}]
      },
      "expect": {
        "completion": {"finish": "stop", "text": "42", "usage": {"input": 24, "output": 3, "total": 27}}
      }
    }
  ],
  "expect_requests": [
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body_includes": {"reasoning_effort": "low", "stream_options": {"include_usage": true}}
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body_includes": {"model": "m", "stream": true},
      "body_excludes": ["reasoning_effort", "stream_options"]
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body_includes": {"model": "m", "stream": true},
      "body_excludes": ["reasoning_effort", "stream_options"]
    }
  ]
}
