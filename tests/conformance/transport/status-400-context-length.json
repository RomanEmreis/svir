{
  "description": "400 with context_length_exceeded is a context overflow.",
  "config": {"base_url": "{server}/v1"},
  "server": [
    {
      "status": 400,
      "headers": {"content-type": "application/json"},
      "body": "{\"error\":{\"code\":\"context_length_exceeded\",\"message\":\"secret-server-detail\"}}"
    }
  ],
  "calls": [{"expect": {"error": "context_overflow", "retryable": false, "status": 400}}],
  "expect_requests": [{"method": "POST", "path": "/v1/chat/completions"}]
}
