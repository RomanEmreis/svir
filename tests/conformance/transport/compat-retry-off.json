{
  "description": "With the lean retry turned off, a 400 to a request with optional fields is reported as it is, and nothing is learned: the next request carries them again (D48).",
  "config": {"base_url": "{server}/v1", "lean_retry": false},
  "server": [
    {
      "status": 400,
      "headers": {"content-type": "application/json"},
      "body": "{\"error\":{\"code\":\"unsupported_parameter\",\"message\":\"secret-server-detail\"}}"
    },
    {
      "status": 200,
      "headers": {"content-type": "text/event-stream"},
      "body_file": "../decoder/final.sse"
    }
  ],
  "calls": [
    {
      "request": {
        "model": "m",
        "reasoning_effort": "high",
        "include_usage": true,
        "messages": [{"role": "user", "parts": [{"text": "hi"}]}]
      },
      "expect": {
        "error": "unsupported",
        "retryable": false,
        "status": 400,
        "message": "secret-server-detail"
      }
    },
    {
      "request": {
        "model": "m",
        "reasoning_effort": "high",
        "include_usage": true,
        "messages": [{"role": "user", "parts": [{"text": "hi"}]}]
      },
      "expect": {
        "completion": {"finish": "stop", "text": "42", "usage": {"input": 24, "output": 3, "total": 27}}
      }
    }
  ],
  "expect_requests": [
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body_includes": {"reasoning_effort": "high", "stream_options": {"include_usage": true}}
    },
    {
      "method": "POST",
      "path": "/v1/chat/completions",
      "body_includes": {"reasoning_effort": "high", "stream_options": {"include_usage": true}}
    }
  ]
}
