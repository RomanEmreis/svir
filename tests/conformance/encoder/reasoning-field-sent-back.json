{
  "description": "reasoning goes back unchanged under the same key.",
  "request": {
    "model": "m",
    "messages": [
      {"role": "user", "parts": [{"text": "hi"}]},
      {
        "role": "assistant",
        "parts": [{"reasoning": {"source": "reasoning", "text": "thought"}}, {"text": "42"}]
      },
      {"role": "user", "parts": [{"text": "and?"}]}
    ]
  },
  "options": {"send_reasoning": true},
  "expect": {
    "body": {
      "model": "m",
      "stream": true,
      "messages": [
        {"role": "user", "content": "hi"},
        {"role": "assistant", "content": "42", "reasoning": "thought"},
        {"role": "user", "content": "and?"}
      ]
    }
  }
}
