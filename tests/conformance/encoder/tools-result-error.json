{
  "description": "A failed tool result has no field of its own in Chat Completions; it is told in the text, as error: before the caller's message.",
  "request": {
    "model": "m",
    "messages": [
      {"role": "user", "parts": [{"text": "Use lookup"}]},
      {
        "role": "assistant",
        "parts": [{"tool_call": {"id": "call-a", "name": "lookup", "arguments": "{\"value\":\"x\"}"}}]
      },
      {
        "role": "tool",
        "parts": [{"tool_result": {"call_id": "call-a", "content": "invalid arguments: \"x\" is not a number", "is_error": true}}]
      }
    ]
  },
  "expect": {
    "body": {
      "model": "m",
      "stream": true,
      "messages": [
        {"role": "user", "content": "Use lookup"},
        {
          "role": "assistant",
          "content": "",
          "tool_calls": [
            {
              "id": "call-a",
              "type": "function",
              "function": {"name": "lookup", "arguments": "{\"value\":\"x\"}"}
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "call-a",
          "content": "error: invalid arguments: \"x\" is not a number"
        }
      ]
    }
  }
}
