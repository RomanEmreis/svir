{
  "description": "The model listing follows has_more with after_id; display_name is the name (D50).",
  "config": {
    "base_url": "{server}",
    "api_key": "secret-key"
  },
  "server": [
    {
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"data\": [{\"type\": \"model\", \"id\": \"a\", \"display_name\": \"A\", \"created_at\": \"2026-01-01T00:00:00Z\"}], \"has_more\": true, \"first_id\": \"a\", \"last_id\": \"a\"}"
    },
    {
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"data\": [{\"type\": \"model\", \"id\": \"b\", \"display_name\": \"B\", \"created_at\": \"2025-01-01T00:00:00Z\"}], \"has_more\": false, \"first_id\": \"b\", \"last_id\": \"b\"}"
    }
  ],
  "calls": [
    {
      "list_models": true,
      "expect": {
        "models": [
          {
            "id": "a",
            "name": "A"
          },
          {
            "id": "b",
            "name": "B"
          }
        ]
      }
    }
  ],
  "expect_requests": [
    {
      "method": "GET",
      "path": "/v1/models?limit=1000",
      "headers": {
        "authorization": "Bearer secret-key",
        "anthropic-version": "2026-10-21"
      }
    },
    {
      "method": "GET",
      "path": "/v1/models?limit=1000&after_id=a"
    }
  ]
}
