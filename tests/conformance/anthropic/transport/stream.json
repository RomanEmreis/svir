{
  "description": "A stream from /v1/messages, with the API version, the key as a Bearer token, and the body svir writes.",
  "config": {
    "base_url": [
      "{server}",
      "{server}/v1/"
    ],
    "api_key": "secret-key"
  },
  "server": [
    {
      "status": 200,
      "headers": {
        "content-type": "text/event-stream"
      },
      "body_file": "../decoder/text.sse"
    }
  ],
  "calls": [
    {
      "expect": {
        "completion": {
          "finish": "stop",
          "text": "Rivers meander.",
          "parts": [
            {
              "text": "Rivers meander."
            }
          ],
          "usage": {
            "input": 25,
            "output": 12
          }
        }
      }
    }
  ],
  "expect_requests": [
    {
      "method": "POST",
      "path": "/v1/messages",
      "headers": {
        "authorization": "Bearer secret-key",
        "anthropic-version": "2026-10-21",
        "accept": "text/event-stream"
      },
      "absent_headers": [
        "x-api-key"
      ],
      "body_includes": {
        "model": "m",
        "max_tokens": 16,
        "stream": true
      }
    }
  ]
}
